# Required: Gmail API OAuth files and digest recipient.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
DIGEST_EMAIL_TO=your-email@gmail.com

# Required for skip-trace/valuation/permits enrichment. No free trial;
# BatchData's wallet needs a $50 minimum balance before any call succeeds.
BATCHDATA_API_KEY=your_batchdata_api_token

# Optional: target number of leads worth pursuing to find per run (not a
# cap on candidates enriched — see README's "Cost control"). Defaults to 25.
# BATCHDATA_MAX_LEADS_PER_RUN=25

# Optional: hard ceiling on how many candidates get enriched (billed) while
# searching for BATCHDATA_MAX_LEADS_PER_RUN matches, for when the match
# rate is low. Defaults to 5x the target above.
# BATCHDATA_MAX_ENRICHMENT_ATTEMPTS=125

# Optional: uncomment all three for persistent state on Render (its cron
# jobs get a fresh, ephemeral disk each run otherwise).
# ST_GITHUB_TOKEN=github_pat_replace_me
# ST_GITHUB_REPO=jpdeburgo/skip-tracer
# ST_GIT_BRANCH=main

# Optional: where the local-only, gitignored full-lead archive is written
# (every enriched lead, pursued or not — owner name/phone/email, valuation,
# distress flags. See archive.py's module docstring for why this
# deliberately never syncs to GitHub). Defaults to leads_archive.json in
# the repo root. Point this at a mounted persistent disk if running on a
# host with an ephemeral one and you want it to survive between runs.
# LEADS_ARCHIVE_PATH=leads_archive.json

# Optional: where the local-only, gitignored record of leads that actually
# passed filter_worth_pursuing() (i.e. were sent in a digest) is written —
# a standing copy independent of the email itself. Same never-syncs-to-
# GitHub reasoning as LEADS_ARCHIVE_PATH above.
# QUALIFIED_LEADS_PATH=qualified_leads.json

# Optional: where the local-only, gitignored raw-BatchData-response cache
# is written (see batchdata_cache.py's module docstring). Lets
# scripts/reprocess_from_cache.py re-derive leads_archive.json/
# qualified_leads.json after a logic change with zero new BatchData calls.
# Same never-syncs-to-GitHub reasoning as the two paths above — if
# anything, more so, since this holds the raw, unfiltered response.
# BATCHDATA_CACHE_PATH=batchdata_cache.json
